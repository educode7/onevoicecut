# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Test / tooling caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.codegraph/

# Per-machine agent scratch — not part of the change artifacts they sit next to
.qwen/
.gentle-ai-instance

# Environment / secrets (API keys for cloud ASR and LLM adapters)
.env
.env.*
!.env.example

# Uploaded media and generated artifacts — never commit source video/audio
uploads/
media/
output/
# Anchored: this names the generated-artifacts dir at the repo root. The bare
# form matched every directory called transcripts/ anywhere, which would
# silently ignore the source package at src/onevoicecut/systems/pipeline/transcripts/.
/transcripts/
# data/ is the shared-server data directory: job.json carries operator names,
# and the job directories carry sermons and transcripts (R6).
data/
*.mp4
*.mov
*.mkv
*.webm
*.mp3
*.wav
*.m4a

# Local ASR model weights
models/
*.bin
*.gguf

# OS
Thumbs.db
.DS_Store
.claude/
.atl/
.opencode/
.codegraph/
