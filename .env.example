# OneVoiceCut configuration template. Copy to `.env` beside the app and fill in
# values; `.env` is gitignored and must never be committed. The file is loaded at
# each composition root with override=False: a real exported variable always
# wins over the value written here.

# Directory where jobs and artifacts are stored. Required; no default on purpose.
# ONEVOICECUT_DATA_DIR=
# Operator credentials as `name:token;name:token`. Required for any HTTP access.
# ONEVOICECUT_OPERATOR_TOKENS=
# Ceiling for a single uploaded source file, in bytes.
# ONEVOICECUT_MAX_UPLOAD_BYTES=
# Maximum transcription jobs running at once.
# ONEVOICECUT_MAX_CONCURRENT_JOBS=
# Maximum render processes running at once; independent of the job cap.
# ONEVOICECUT_MAX_CONCURRENT_RENDERS=
# Per-chunk transcription timeout, in seconds.
# ONEVOICECUT_CHUNK_TIMEOUT_SECONDS=
# Comma-separated clip script targets, e.g. tiktok,instagram,youtube,facebook.
# ONEVOICECUT_SCRIPT_TARGETS=
# faster-whisper model size for the local engine (tiny|base|small|medium|large-v3). No default: it decides quality and hours of runtime.
# ONEVOICECUT_LOCAL_MODEL_SIZE=
# Device for the local engine: auto, cpu, or cuda.
# ONEVOICECUT_LOCAL_DEVICE=
# SECRET: API key for the cloud ASR engine. Never commit a real value.
# CLOUD_ASR_API_KEY=
# SECRET: HuggingFace token licensing the gated pyannote diarization weights. Never commit a real value.
# HUGGING_FACE_TOKEN=
